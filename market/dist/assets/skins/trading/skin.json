  "tags": [
    "stock",
    "trading",
    "ticker",
    "live",
    "terminal",
    "longbridge"
  ],
  "accent": "#f23645",
  "order": 9,
  "version": "0.2.0",
  "preview": {
    "light": "preview/light.jpg",
    "dark": "preview/dark.jpg"
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "x-org.linxin666.skin-center/v1alpha1",
        "kind": "SkinHooks",
        "optional": true
      }
    ]
  },
  "contributes": {
    "stylesheet": "skin.css",
    "patches": "patches.css"
  },
  "facets": {
    "client": {
      "entry": "hooks.mjs",
      "apiVersion": "x-org.linxin666.skin-center/v1alpha1"
    }
  }
