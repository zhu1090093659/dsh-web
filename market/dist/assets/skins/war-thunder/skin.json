{
  "$schema": "https://schemas.linxin666.org/dsh-skin/v2.json",
  "skinManifestVersion": 2,
  "id": "war-thunder",
  "name": "战争雷霆 · 钢铁前线",
  "nameEn": "War Thunder Frontline",
  "version": "0.1.0",
  "author": "dsh-web",
  "tagline": "游戏登录背景 · 橄榄军绿玻璃面板 · 星徽标题栏与陆海空模式条",
  "description": "以战争雷霆（War Thunder）游戏美术为灵感的军事主题皮肤：亮暗主题各配一幅游戏内登录背景（取自本机游戏客户端素材，只读解包后重新编码），橄榄军绿半透明面板透出战场景，标题栏带官方星徽，底部是 TANKS / AVIATION / FLEET 三段模式条，琥珀金强调色贯穿按钮与选区。",
  "tags": [
    "war-thunder",
    "military",
    "aviation",
    "tank",
    "navy",
    "game"
  ],
  "accent": "#d9a441",
  "order": 102,
  "preview": {
    "light": "preview/light.png",
    "dark": "preview/dark.png"
  },
  "license": "Personal use only; game artwork is copyrighted by Gaijin Entertainment",
  "attribution": "背景美术与启动器星徽取自本机 War Thunder 游戏客户端（登录页素材与 launcher.ico，只读解包），版权归 Gaijin Entertainment 所有，仅供个人非商业使用；皮肤本体代码由本仓库按仓库许可发布",
  "requires": {
    "contracts": [
      {
        "apiVersion": "x-org.linxin666.skin-center/v1alpha1",
        "kind": "SkinHooks",
        "optional": true
      }
    ]
  },
  "contributes": {
    "stylesheet": "skin.css",
    "patches": "patches.css",
    "backgroundMedia": {
      "light": {
        "type": "image",
        "src": "assets/light-art.webp",
        "scrim": "linear-gradient(rgba(239, 234, 218, 0.04) 0%, rgba(233, 227, 209, 0.06) 55%, rgba(222, 214, 192, 0.09) 100%)"
      },
      "dark": {
        "type": "image",
        "src": "assets/dark-art.webp",
        "scrim": "linear-gradient(rgba(9, 11, 8, 0.1) 0%, rgba(11, 13, 10, 0.14) 60%, rgba(8, 10, 8, 0.18) 100%)"
      }
    }
  },
  "facets": {
    "client": {
      "entry": "hooks.mjs",
      "apiVersion": "x-org.linxin666.skin-center/v1alpha1"
    }
  }
}
