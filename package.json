{
  "name": "dsh-web",
  "version": "0.4.13",
  "private": true,
  "description": "DeepSeek Harness Web GUI 插件全家桶。皮肤、宠物与社区插件索引已拆分为独立仓库（dsh-skins / dsh-pet / dsh-community-plugins），本仓通过 npm 包内置它们。",
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-web-all/cordis.patch.yml"
    }
  },
  "files": [
    "package.json",
    "packages/dsh-web-all/cordis.patch.yml",
    "locale"
  ],
  "dependencies": {
    "@linxin666/dsh-web-all": "^0.4.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:watch": "node scripts/dev-watch.mjs",
    "test": "pnpm -r test",
    "test:standards": "node scripts/test-standards.mjs --check",
    "test:standards:write": "node scripts/test-standards.mjs --write-baseline",
    "typecheck": "pnpm -r typecheck",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "runtime-deps:check": "node scripts/runtime-deps-check.mjs",
    "libs:check": "node scripts/lib-artifact-check.mjs",
    "libs:write": "node scripts/lib-artifact-check.mjs --write",
    "i18n:check": "node scripts/i18n-audit.mjs --check",
    "emoji:check": "node scripts/emoji-audit.mjs",
    "lint": "oxlint --deny-warnings --format=unix .",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:mount": "bash scripts/e2e-mount.sh",
    "coverage:check": "node scripts/coverage-gate.mjs",
    "coverage:write": "node scripts/coverage-gate.mjs --write-baseline",
    "pr:review": "node scripts/pr-review.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "docs:list": "node scripts/verify-docs.mjs --list",
    "docs:write-pair": "node scripts/verify-docs.mjs --write",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-shared:check": "node scripts/sync-shared.mjs --check",
    "market:build": "node scripts/market-build",
    "market:check": "node scripts/market-build --check",
    "market:fetch": "node scripts/market-fetch-inputs.mjs",
    "market:verify": "node scripts/market-verify-assets.mjs",
    "deploy:market": "node scripts/deploy-market"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-crypto": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-time": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-web-frontend": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@playwright/test": "^1.62.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.8",
    "es-module-lexer": "2.3.2",
    "lightningcss": "^1.32.0",
    "oxlint": "1.88.0",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "tsdown": "^0.22.2"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0"
}
