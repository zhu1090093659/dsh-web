{
  // Host-half program (node process side): the /aionui-panel fs/git services.
  // SDK types resolve from the @deepseek-ai/* npm packages declared in
  // devDependencies (official NPM SDK), never from a source checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/mount-once.ts",
    "src/core/**/*.ts",
    "src/host/**/*.ts"
  ]
}
