{
  "name": "@linxin666/dsh-client-ui-market",
  "description": "Workshop browser card: browse skins, pets and community plugins from dsh-market.com and install them in the GUI (assets into the DSH home directories, plugins through the optional plugin manager).",
  "version": "0.4.13",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.2.0"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web.git"
  }
}
