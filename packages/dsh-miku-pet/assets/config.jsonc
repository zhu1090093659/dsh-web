// miku-pet 配置(JSONC)
// 动作池与权重。帧素材:assets/thumb/<键>/ 下的 png 帧序列(方形,人物脚底约 90%)。
// 随机待机规则与桌面版(desktop-pet)一致:待机时每 5s 判定一次,
// 演动作概率 = categories 权重占比(idle 40 / categories 60 → 60%),
// 连续 2 次未抽中 → 下次必演(保底),演出成功或离开待机计数清零。
{
  // ===================== 宠物(多开) =====================
  "pets": [
    {
      "id": "main",
      "name": "Miku",
      "size": 220,
      "position": { "corner": "top-right", "marginX": 20, "marginY": 96 }
    }
  ],

  // ===================== 动作池 =====================
  "animations": {
    // 待机(停止动作;idle 循环播放,随机演出由 5s 掷骰驱动)
    "idle": ["idle"],
    // 转向:无素材,留空
    "turn": [],
    // 拖拽中的姿势
    "drag": ["drag"],
    // 拖拽结束:摔倒→站起(播一次即回 idle,不参与随机、不进菜单;与桌面版一致)
    "standup": ["standup"],
    // 点击回应
    "clicks": ["blink1", "blink2", "scratch"],
    // 移动:无走路帧素材,留空(不会触发屏幕漫游)
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": []
    },
    // 随机动作分类池(权重合计 60 = 60% 演动作)
    "categories": [
      { "id": "小动作", "weight": 36, "actions": ["scratch", "blink1", "blink2"] },
      { "id": "吃饭", "weight": 24, "actions": ["eat"] }
    ]
  },

  // ===================== 随机待机顶层权重 =====================
  // idle + turn + move + categories 合计 = 100。当前:40 + 0 + 0 + 60 = 100。
  // 每 5s 掷骰:roll 落在 idle 档(40%)保持待机,否则(60%)从 categories 演一个动作;
  // rollKind 纯函数见 src/client/pickers.ts,节拍与必演逻辑见 src/client/pet.ts。
  "animationWeights": {
    "idle": 40,
    "turn": 0,
    "move": 0
  },

  // ===================== 气泡台词(按动作名) =====================
  // 点击/随机动作播放时,宠物上方弹出对应动作的随机一句;
  // 缺省该动作没有词库则不弹气泡。key 与 animations/categories 里的动作名一致。
  "phrases": {
    "scratch": ["头有点痒~", "在想事情呢…", "肚肚也有点饿了..."],
    "blink1": ["眼睛进沙子啦~", "眨眨眼~", "灯光有点刺眼~"],
    "blink2": ["好困…", "先眯一会儿~", "打个哈欠再说~"],
    "eat": ["好吃!再来一碗~", "这块蛋糕真不错~", "吃饱啦~", "零食储备+1~"],
    "success": ["工作成功,金币+3!~", "领到工资啦~", "今天的任务完成~"],
    "fail": ["工作失败…金币-1~", "啊,搞砸了……", "下次一定行~"]
  }
}