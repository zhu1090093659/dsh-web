{
  // Browser-half program (Web GUI side). SDK types resolve from the
  // @deepseek-ai/* npm packages declared in devDependencies (official
  // NPM SDK), never from a source checkout. node types are included so the
  // shared core modules typecheck here too; the browser bundle is produced
  // by tsdown, which only follows the client entry's real imports.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/core/**/*.ts",
    "src/css-modules.d.ts"
  ]
}
