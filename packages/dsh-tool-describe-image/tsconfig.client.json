{
  // Browser-half program (Web GUI side): the composer image attach button.
  // SDK types resolve from the @deepseek-ai/* npm packages declared in
  // devDependencies (official NPM SDK), never from a source checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": []
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
