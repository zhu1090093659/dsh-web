{
  // Host-half program (node process side): tool registration, the attach
  // route, the settings section, and the media facts. SDK types resolve
  // from the @deepseek-ai/* npm packages declared in devDependencies
  // (official NPM SDK), never from a source checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/mount-once.ts",
    "src/invariant.ts",
    "src/media.ts",
    "src/attachment-reference.ts",
    "src/attach-routes.ts",
    "src/model-capability.ts",
    "src/model-probe.ts",
    "src/loopback.ts",
    "src/url-guard.ts",
    "src/tool-visibility.ts",
    "src/native-images.ts",
    "src/config-resolve.ts",
    "src/http.ts",
    "src/vision-client.ts"
  ]
}
