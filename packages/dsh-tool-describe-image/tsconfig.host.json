{
  // Host-half program (node process side): tool registration, the attach
  // route, the plugin config, and the media facts. SDK types resolve
  // from the @deepseek-ai/* npm packages declared in devDependencies
  // (official NPM SDK), never from a source checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Pin the SDK's cordis module to this package's own dependency. The
    // optional cordis peers this package needs for its Loader tests
    // (cordis-plugin-include / -loader) give the importer a cordis instance of
    // its own, while the @deepseek-ai SDK packages in the same install link
    // the plain workspace instance; without the pin the cordis Context/Events
    // merges those SDK packages declare (ctx.tools, ctx.slots, ctx.configForms,
    // agent/created, ...) land on the other module and every service lookup
    // reports a missing property. Drop the pin once the install resolves one
    // instance for the whole workspace.
    "paths": {
      "@deepseek-ai/cordis": ["./node_modules/@deepseek-ai/cordis"]
    },
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/mount-once.ts",
    "src/invariant.ts",
    "src/media.ts",
    "src/attachment-reference.ts",
    "src/attach-routes.ts",
    "src/model-capability.ts",
    "src/model-probe.ts",
    "src/loopback.ts",
    "src/url-guard.ts",
    "src/tool-visibility.ts",
    "src/native-images.ts",
    "src/config-resolve.ts",
    "src/http.ts",
    "src/vision-client.ts"
  ]
}
