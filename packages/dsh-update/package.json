{
  "name": "@linxin666/dsh-update",
  "description": "Self-update plugin for the dsh web GUI: probes npm for newer family releases and runs the owning profile's pnpm update in place, from a sidebar trigger beside the settings seat with a release-notes panel",
  "version": "0.4.13",
  "icon": "icon.svg",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "watch": "tsdown --watch",
    "prepare": "tsc -b && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web.git"
  }
}
