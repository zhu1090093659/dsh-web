{
  "name": "@linxin666/dsh-usage",
  "description": "Usage statistics plugin for the dsh web GUI: per-provider balance and coding-plan quota detection plus a live token usage ledger, with a dedicated pet bubble for the current provider",
  "version": "0.3.12",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.4"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "watch": "tsdown --watch",
    "prepare": "tsc -p tsconfig.build.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@linxin666/dsh-pet": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web.git"
  }
}
