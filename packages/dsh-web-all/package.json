{
  "name": "@linxin666/dsh-web-all",
  "description": "DSH Web UI 全家桶聚合插件：一键安装全部功能插件（task-board / git-graph / pet / remote-web-ui / web-ui-settings / skin-center / community-plugins / compat shim）。compat 桥接层已并入本包（src/client），无需独立 compat npm 包。",
  "version": "0.3.8",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepare": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web.git"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@linxin666/dsh-client-ui-plugin-manager": "workspace:*",
    "@linxin666/dsh-client-ui-community-plugins": "workspace:*",
    "@linxin666/dsh-client-ui-market": "workspace:*",
    "@linxin666/dsh-client-ui-task-board": "workspace:*",
    "@linxin666/dsh-client-ui-git-graph": "workspace:*",
    "@linxin666/dsh-perf": "workspace:*",
    "@linxin666/dsh-pet": "workspace:*",
    "@linxin666/dsh-remote-web-ui": "workspace:*",
    "@linxin666/dsh-ssh": "workspace:*",
    "@linxin666/dsh-tool-describe-image": "workspace:*",
    "@linxin666/dsh-liangshen": "workspace:*",
    "@linxin666/dsh-client-ui-skill-explorer": "workspace:*",
    "@linxin666/dsh-desktop-launcher": "workspace:*",
    "@linxin666/dsh-doctor": "workspace:*",
    "@linxin666/dsh-usage": "workspace:*",
    "@linxin666/dsh-client-ui-web-ui-settings": "workspace:*",
    "@linxin666/dsh-client-ui-skin-center": "workspace:*",
    "@mlgbnb/dsh-archive-manager": "1.0.7",
    "@morlay/better-session": "0.0.11",
    "dsh-better-sidebar": "0.15.2"
  }
}
