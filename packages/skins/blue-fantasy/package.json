{
  "name": "@linxin666/dsh-client-ui-skin-blue-fantasy",
  "description": "Hot-pluggable 蓝色幻想 (blue-fantasy) skin for the dsh web GUI: the DreamSkin Codex theme「DeepSeek-鲸鱼娘」adapted — whale-art backdrop with live theme scrim, periwinkle-indigo palette, translucent panes",
  "version": "0.1.11",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {},
  "devDependencies": {
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git"
  }
}
