{
  "name": "@linxin666/dsh-client-ui-skin-miku",
  "description": "Hot-pluggable 初音未来 (miku) skin for the dsh web GUI: blue-violet-magenta gradients, frosted glass panels and inputs, customizable backdrop art, light & dark themes",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {},
  "devDependencies": {
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "LICENSE"
  ]
}
