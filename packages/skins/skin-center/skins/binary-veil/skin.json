{
  "$schema": "https://schemas.linxin666.org/dsh-skin/v2.json",
  "skinManifestVersion": 2,
  "id": "binary-veil",
  "name": "二进制面纱",
  "nameEn": "Binary Veil",
  "version": "1.0.0",
  "author": "stushansusu",
  "tagline": "黑白剪影 · 0/1 代码雨 · 人物站在数字前面",
  "description": "把黑白剪影片逐帧重绘成 0/1 数字场：亮部整片换成代码雨，剪影原样压在数字之上；背景用原片全片（3:52）循环播放，逐帧离线烘焙、不依赖运行时着色器。面板是墨绿玻璃、侧栏半透明，视频整幅居中铺满、构图不被裁切，贯穿整屏。强调色就是数字本身的荧光绿。",
  "tags": [
    "binary",
    "matrix",
    "code-rain",
    "green",
    "silhouette",
    "video-background",
    "dark",
    "terminal"
  ],
  "accent": "#6bff9e",
  "order": 40,
  "preview": {
    "light": "preview/light.jpg",
    "dark": "preview/dark.jpg"
  },
  "contributes": {
    "stylesheet": "skin.css",
    "patches": "patches.css",
    "backgroundMedia": {
      "light": {
        "type": "video",
        "src": "assets/binary-veil-loop.mp4",
        "scrim": "linear-gradient(180deg, rgba(3,6,5,0.26) 0%, rgba(3,6,5,0.10) 16%, rgba(3,6,5,0.08) 78%, rgba(3,6,5,0.24) 100%)"
      },
      "dark": {
        "type": "video",
        "src": "assets/binary-veil-loop.mp4",
        "scrim": "linear-gradient(180deg, rgba(3,6,5,0.26) 0%, rgba(3,6,5,0.10) 16%, rgba(3,6,5,0.08) 78%, rgba(3,6,5,0.24) 100%)"
      }
    }
  }
}
