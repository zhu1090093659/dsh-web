      },
      "dark": {
        "type": "image",
        "src": "assets/tokyo-night-art.webp",
        "scrim": "linear-gradient(rgba(10, 12, 20, 0.3) 0%, rgba(12, 14, 24, 0.38) 60%, rgba(15, 17, 28, 0.46) 100%)"
      }
