#!/usr/bin/env node
'use strict'

/**
 * dsh-skin-new — scaffold a new skin for the dsh-web-ui skin collection.
 *
 * Generates packages/skins/<name>/ from the official standalone bundle standard
 * (turtle-ui shape): package.json with `dsh.bundle` + `dsh.client` +
 * self-contained `prepare` build, cordis.patch.yml, tsdown.config.ts,
 * skin.json, a minimal apply()/dispose client entry with a scoped stylesheet,
 * and a generic apply spec. The author then fills in the skin.json metadata
 * and the CSS/TS surface, runs `pnpm build`/`pnpm test`, regenerates the
 * skin-center registry and gallery, and submits the PR.
 *
 * Usage:
 *   node scripts/dsh-skin-new <kebab-case-name>
 *
 * See .dsh/skills/skin-developer/SKILL.md for the full workflow.
 */

const fs = require('node:fs')
const path = require('node:path')

const ROOT = path.resolve(__dirname, '..')
const SKINS_DIR = path.join(ROOT, 'packages', 'skins')

/** kebab-case per the DSH skill/package naming rule. */
const NAME_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/

// --- name helpers ------------------------------------------------------------

/** 'blue-fantasy' -> 'Blue Fantasy' (display name). */
function displayName(name) {
  return name.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ')
}

/** 'blue-fantasy' -> 'BlueFantasy' (camelCase for dataset keys). */
function pascalName(name) {
  return name.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join('')
}

// --- template fragments ------------------------------------------------------

function pkgJson(name) {
  return {
    name: `@deepseek-ai/dsh-client-ui-skin-${name}`,
    description: `Hot-pluggable ${displayName(name)} skin for the dsh web GUI: <edit me — one line pitch>`,
    version: '0.0.1',
    private: true,
    type: 'module',
    main: 'lib/index.js',
    exports: {
      '.': './lib/index.js',
      './client': './lib/client.js',
      './src/*': './src/*',
      './package.json': './package.json',
    },
    dsh: {
      bundle: { patch: './cordis.patch.yml' },
      client: { inject: [], platform: 'web' },
    },
    scripts: {
      build: 'tsdown',
      prepare: 'tsdown',
      watch: 'tsdown --watch',
      test: 'vitest run',
    },
    license: 'BSD-3-Clause',
    peerDependencies: {},
    devDependencies: {
      jsdom: '29.1.1',
      lightningcss: '^1.32.0',
      tsdown: '^0.22.2',
      'vite-tsconfig-paths': '^6.1.1',
      vitest: '^4.1.8',
      '@deepseek-ai/cordis': '^4.0.1',
    },
    files: ['lib', 'cordis.patch.yml', 'skin.json', 'preview', 'README.md'],
  }
}

function cordisPatch(name) {
  return `# ${name} skin bundle patch: inserts its dsh.client row into the web plugin roster.
# The bundle is the official dsh plugin shape — install it with
# \`dsh plugin --profile <name> add <path-or-git-url>\`; mutual exclusion between
# skins is managed by scripts/dsh-skin (home-layer disabled rows).
- insert:
    - id: ui-skin-${name}
      name: '@deepseek-ai/dsh-client-ui-skin-${name}'
`
}

function tsdownConfig(name) {
  return `import { clientBundle } from '../../../shared/tsdown.client.ts'

export default clientBundle('@deepseek-ai/dsh-client-ui-skin-${name}', ['src/index.ts'])
`
}

function tsconfig() {
  return `{
  // Standalone compiler shape for this skin bundle (self-contained port of
  // the checkout's tsconfig.base.client.json — no monorepo extends).
  // Builds transpile-only (tsdown, dts: false): no type checking, so the
  // @deepseek-ai/dsh-* type-only imports resolve to nothing and are erased.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src"]
}
`
}

function tsconfigVitest() {
  return `{
  // Vitest program: type-checks src + tests together without emitting.
  // SDK types resolve from the @deepseek-ai/* npm devDependencies.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
`
}

function vitestConfig() {
  return `import tsconfigPaths from 'vite-tsconfig-paths'
import { defineConfig } from 'vitest/config'

export default defineConfig({
  plugins: [tsconfigPaths({
    projects: [
      './tsconfig.vitest.json',
    ],
  })],
  test: {
    include: ['tests/**/*.spec.{ts,tsx}'],
    pool: 'forks',
  },
})
`
}

function cssModulesDts() {
  return `declare module '*.module.css' {
  const classes: Record<string, string>
  export default classes
}

declare module '*.css'`
}

function hostIndex() {
  return `/** Host loader entry for the browser-only skin plugin. */

/** Provides no host-side behavior. */
export function apply(): void {}
`
}

function clientIndex(name) {
  const dataAttr = `data-dsh-${name}`
  const title = `${displayName(name)} · DeepSeek 在线`
  return `/**
 * ${displayName(name)} skin — scaffold template. apply() owns the whole surface
 * and retracts it on dispose (the ThemePresenter retraction discipline: the
 * plugin only ever removes what it wrote): the \`${dataAttr}\` body attribute
 * the stylesheet is scoped on, the injected chrome bar, and the document
 * title. The CSS rides the bundle's CSS-modules auto-inject (style tag owned
 * by the loader, removed on entry dispose). No services are injected: the
 * skin needs only the DOM.
 *
 * Style your design in ./${name}.module.css, scoped under
 * body[${dataAttr}] (dark variant body[${dataAttr}][data-ds-dark-theme]).
 */
import type { Context } from '@deepseek-ai/cordis'
import css from './${name}.module.css'

/** The product title the skin pins (captured by the shell's DocumentTitle after settle). */
const SKIN_TITLE = '${title}'

/** Resolve one module class name (fallback only satisfies the indexed-access type). */
const cls = (name: keyof typeof css): string => css[name] ?? ''

/**
 * Apply the ${displayName(name)} skin: body attribute, chrome bar, title.
 * All writes are retracted by the effect disposer on dispose.
 * @param ctx - owning context (the effect lifecycle owns retraction).
 */
export function apply(ctx: Context): void {
  const body = document.body
  const originalTitle = document.title
  body.setAttribute('${dataAttr}', '')

  const titlebar = document.createElement('div')
  titlebar.className = cls('titlebar')
  // data-skin-chrome marks every injected element for the apply spec.
  titlebar.dataset.skinChrome = 'titlebar'
  const title = document.createElement('span')
  title.className = cls('title')
  title.textContent = SKIN_TITLE
  titlebar.append(title)
  body.append(titlebar)

  document.title = SKIN_TITLE

  ctx.effect(() => () => {
    body.removeAttribute('${dataAttr}')
    titlebar.remove()
    // Only restore when the skin's own title still stands — a session title
    // projected by the shell must not be clobbered by skin teardown.
    if (document.title === SKIN_TITLE) document.title = originalTitle
  }, 'ui-skin-${name}: ${displayName(name)} chrome')
}
`
}

function moduleCss(name) {
  const dataAttr = `data-dsh-${name}`
  return `/* ${displayName(name)} skin — scoped under body[${dataAttr}].
   The base theme system keeps flipping tokens underneath; remap them or paint
   your own surfaces. Dark variant: body[${dataAttr}][data-ds-dark-theme]. */

body[${dataAttr}] {
  --dsh-accent: #6c5ce7;
}

body[${dataAttr}] .titlebar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  height: 32px;
  padding: 0 12px;
  gap: 8px;
  background: linear-gradient(180deg, #7c6cf0, #4c3fb8);
  color: #fff;
  font-family: ui-sans-serif, system-ui, sans-serif;
  font-size: 12px;
}

body[${dataAttr}] .title {
  font-weight: 600;
}

body[${dataAttr}][data-ds-dark-theme] .titlebar {
  background: linear-gradient(180deg, #3a2f8a, #241c58);
}
`
}

function skinJson(name, order) {
  return {
    id: name,
    name: `${displayName(name)} 皮肤`,
    nameEn: `${displayName(name)} Skin`,
    author: 'dsh-web-ui',
    tagline: '<编辑：一句话卖点>',
    description: '<编辑：长一点的介绍>',
    tags: [name, 'new'],
    accent: '#6c5ce7',
    bodyAttr: `data-dsh-${name}`,
    package: `@deepseek-ai/dsh-client-ui-skin-${name}`,
    wiring: { id: `ui-skin-${name}`, bundleWired: false },
    preview: {
      light: `packages/skins/${name}/preview/light.png`,
      dark: `packages/skins/${name}/preview/dark.png`,
    },
    order,
  }
}

function applySpec(name) {
  const dataAttr = `data-dsh-${name}`
  return `// @vitest-environment jsdom
/**
 * ${displayName(name)} skin apply spec — the template contract: the body
 * attribute the stylesheet is scoped on is set on apply and retracted on
 * dispose, and every injected chrome element (marked data-skin-chrome) is
 * removed. Extend with assertions specific to your surface.
 */
import { afterEach, describe, expect, it } from 'vitest'
import { Context, type Fiber } from '@deepseek-ai/cordis'
import { apply } from '../src/client/index.ts'

let fiber: Fiber | undefined

async function mount(): Promise<Fiber> {
  const f = new Context().plugin({ apply })
  await f.await()
  return f
}

afterEach(async () => {
  await fiber?.dispose()
  fiber = undefined
  document.body.innerHTML = ''
  document.title = ''
})

describe('${displayName(name)} skin apply', () => {
  it('sets the body attribute and retracts it on dispose', async () => {
    fiber = await mount()
    expect(document.body.hasAttribute('${dataAttr}')).toBe(true)
    await fiber.dispose()
    expect(document.body.hasAttribute('${dataAttr}')).toBe(false)
  })

  it('injects chrome and retracts every element on dispose', async () => {
    fiber = await mount()
    expect(document.body.querySelectorAll('[data-skin-chrome]').length).toBeGreaterThan(0)
    await fiber.dispose()
    expect(document.body.querySelectorAll('[data-skin-chrome]').length).toBe(0)
  })

  it('pins the skin title and restores the original on dispose', async () => {
    document.title = 'original'
    fiber = await mount()
    expect(document.title).not.toBe('original')
    await fiber.dispose()
    expect(document.title).toBe('original')
  })
})
`
}

function readme(name) {
  const dataAttr = `data-dsh-${name}`
  const display = displayName(name)
  return `# @deepseek-ai/dsh-client-ui-skin-${name}

${display} skin for the dsh web GUI — <edit me: one-line pitch>.

Hot-pluggable as a client plugin in the official standalone bundle shape:
\`apply()\` sets the \`${dataAttr}\` body attribute (the scope of the whole
stylesheet), renders the chrome, and pins the document title; its effect
disposer retracts every write. The stylesheet rides the bundle's CSS-modules
auto-inject, so the loader removes it with the entry.

The skin is presentation-only: no services are injected, no cordis events are
emitted, and nothing reaches a model request.

## Installing (official bundle)

1. Local path: \`dsh plugin --profile <name> add /path/to/dsh-web-ui/packages/skins/${name}\`
2. Git: \`dsh plugin --profile <name> add github:<org>/dsh-web-ui#<sha>\` —
   pnpm ≥10 asks once for \`allowBuilds\` authorization (the \`prepare\` script
   self-containedly builds \`lib/\`; no monorepo reference needed).
3. Switch with \`scripts/dsh-skin\` (\`dsh-skin use ${name}\`); only one skin is
   ever active at a time.

## Building and testing

\`\`\`sh
pnpm build   # tsdown: lib/index.js + lib/client.js (self-contained preset)
pnpm test    # vitest: apply/dispose contract spec
\`\`\`

## Publishing to the skin center

\`\`\`sh
node scripts/skin-center-bundles    # re-embed this skin into skin-center's registry
pnpm --filter @linxin666/dsh-client-ui-skin-center build
node scripts/gallery-build          # refresh the gallery manifest/bundles
node scripts/capture-previews       # re-shoot preview/light.png + preview/dark.png
\`\`\`

Then commit everything (lib/, preview/, regenerated registry/gallery) and open a PR.
`
}

// --- scaffold -----------------------------------------------------------------

function main() {
  const name = process.argv[2]
  if (!name || !NAME_RE.test(name)) {
    console.error(`usage: node scripts/dsh-skin-new <kebab-case-name>  (e.g. dsh-skin-new matrix)`)
    process.exit(1)
  }
  const dir = path.join(SKINS_DIR, name)
  if (fs.existsSync(dir)) {
    console.error(`packages/skins/${name} already exists — refusing to overwrite`)
    process.exit(1)
  }

  // order: max existing + 1
  let order = 1
  for (const entry of fs.readdirSync(SKINS_DIR)) {
    const skinJson = path.join(SKINS_DIR, entry, 'skin.json')
    if (!fs.statSync(skinJson, { throwIfNoEntry: false })) continue
    const meta = JSON.parse(fs.readFileSync(skinJson, 'utf8'))
    if (typeof meta.order === 'number' && meta.order >= order) order = meta.order + 1
  }

  fs.mkdirSync(path.join(dir, 'src', 'client'), { recursive: true })
  fs.mkdirSync(path.join(dir, 'tests'), { recursive: true })
  fs.mkdirSync(path.join(dir, 'preview'), { recursive: true })

  const files = {
    'package.json': JSON.stringify(pkgJson(name), null, 2) + '\n',
    'cordis.patch.yml': cordisPatch(name),
    'tsdown.config.ts': tsdownConfig(name),
    'tsconfig.json': tsconfig(),
    'tsconfig.vitest.json': tsconfigVitest(),
    'vitest.config.ts': vitestConfig(),
    'skin.json': JSON.stringify(skinJson(name, order), null, 2) + '\n',
    'README.md': readme(name),
    'src/index.ts': hostIndex(),
    'src/css-modules.d.ts': cssModulesDts(),
    'src/client/index.ts': clientIndex(name),
    [`src/client/${name}.module.css`]: moduleCss(name),
    'tests/apply.spec.ts': applySpec(name),
  }
  for (const [rel, content] of Object.entries(files)) {
    fs.writeFileSync(path.join(dir, rel), content)
  }

  console.log(`scaffolded packages/skins/${name}/`)
  console.log('')
  console.log('next steps:')
  console.log(`  1. edit packages/skins/${name}/skin.json      — 名称 / tagline / 描述 / tags / accent`)
  console.log(`  2. edit packages/skins/${name}/src/client/${name}.module.css  — 你的设计（作用域 body[data-dsh-${name}]）`)
  console.log(`  3. edit packages/skins/${name}/src/client/index.ts           — chrome 元素 / 标题`)
  console.log(`  4. pnpm build && pnpm test           — 构建 + 契约测试`)
  console.log(`  5. open gallery/preview.html?skin=${name}&theme=light  — 试穿`)
  console.log(`  6. node scripts/capture-previews     — 重拍 preview/{light,dark}.png`)
  console.log(`  7. node scripts/skin-center-bundles && pnpm --filter @linxin666/dsh-client-ui-skin-center build`)
  console.log(`  8. node scripts/gallery-build        — 刷新 gallery`)
  console.log('  9. 提交（含 lib/、preview/、重新生成的注册表与 gallery 产物）并发 PR')
  console.log('')
  console.log('完整流程见 .dsh/skills/skin-developer/SKILL.md')
}

main()
