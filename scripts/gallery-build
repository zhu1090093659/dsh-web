#!/usr/bin/env node
'use strict'

/**
 * gallery-build — regenerate the gallery static assets for the dsh skin
 * collection (dsh-web, v2 skin layout, issue #506).
 *
 * Scans each packages/skins/skin-center/skins/<name>/skin.json (the v2 pure
 * asset directory contract; the skin-center package is the only loader) and
 * emits:
 *
 *   gallery/manifest.js  — window.SKIN_MANIFEST = [...skin metadata...]
 *   gallery/styles.js    — window.SKIN_STYLES = { "<skinId>": { stylesheet, patches } }
 *
 * Everything is emitted as <script>-loadable JS (not fetched JSON) so the
 * gallery works from file:// — no server, no CORS — and can be pushed to
 * GitHub Pages unchanged. Stylesheet text is JSON.stringify-escaped into a
 * string literal, so any CSS content is safe.
 *
 * The preview simulator renders a skin statically: it injects skin.css (and
 * the optional patches.css) into the official-facade snapshot and paints the
 * declarative contributes.backgroundMedia (image/video + scrim) on a fixed
 * layer, mirroring the skin-center runtime. Skin JS (hooks.mjs) is never
 * executed, so the gallery needs no per-skin bundles.
 *
 * Usage: node scripts/gallery-build [--check]
 *   --check  verify the committed gallery assets are up to date (exit 1 if
 *            a rebuild would change them; used by CI / pre-commit).
 */

const fs = require('node:fs')
const path = require('node:path')

const ROOT = path.resolve(__dirname, '..')
const SKINS_DIR = path.join(ROOT, 'packages', 'skins', 'skin-center', 'skins')
const GALLERY_DIR = path.join(ROOT, 'gallery')

/** Required keys per v2 skin metadata entry. */
const REQUIRED = ['id', 'name', 'nameEn', 'author', 'version', 'accent']

function readSkinMeta(dir, name) {
  const file = path.join(dir, 'skin.json')
  if (!fs.existsSync(file)) return null
  let meta
  try {
    meta = JSON.parse(fs.readFileSync(file, 'utf8'))
  } catch (err) {
    throw new Error(`skin.json parse error in ${dir}: ${err.message}`)
  }
  if (meta.skinManifestVersion !== 2) {
    throw new Error(`skin ${name}: skin.json must declare "skinManifestVersion": 2`)
  }
  for (const key of REQUIRED) {
    if (!meta[key]) throw new Error(`skin ${name}: missing required skin.json field "${key}"`)
  }
  if (meta.id !== name) {
    throw new Error(`skin ${name}: skin.json id "${meta.id}" must equal the directory name`)
  }
  return meta
}

/**
 * Read one contributed stylesheet relative to the skin directory, normalized
 * to LF so Windows and POSIX checkouts emit the same gallery registry.
 */
function readSkinFile(dir, rel, label) {
  if (typeof rel !== 'string' || !rel) return null
  const abs = path.resolve(dir, rel)
  if (path.relative(dir, abs).startsWith('..') || path.isAbsolute(path.relative(dir, abs))) {
    throw new Error(`skin ${path.basename(dir)}: ${label} escapes the skin directory: ${rel}`)
  }
  if (!fs.existsSync(abs)) {
    throw new Error(`skin ${path.basename(dir)}: ${label} not found: ${rel}`)
  }
  return fs.readFileSync(abs, 'utf8').replace(/\r\n?/g, '\n')
}

function scanSkins() {
  const skins = []
  for (const name of fs.readdirSync(SKINS_DIR).sort()) {
    const dir = path.join(SKINS_DIR, name)
    if (!fs.statSync(dir).isDirectory()) continue
    const meta = readSkinMeta(dir, name)
    if (!meta) continue
    skins.push({ name, dir, meta })
  }
  if (!skins.length) throw new Error('no skins found under packages/skins/skin-center/skins/')
  // 入库顺序（skin.json 的 order 字段）决定 Gallery 卡片顺序
  skins.sort((a, b) => (a.meta.order ?? 999) - (b.meta.order ?? 999))
  return skins
}

/**
 * preview.light/dark are mandatory for the gallery: both must be declared in
 * skin.json and resolve (relative to the skin directory) to real files. The
 * emitted manifest rewrites them to repo-root-relative paths, exactly how
 * gallery/index.html loads them ('../' + preview.light).
 */
/**
 * Rewrite contributes.backgroundMedia srcs the same way as previews: the
 * emitted manifest carries repo-root-relative paths so gallery/preview.html
 * (and the deployed site root) can resolve them as '..' + src, and validates
 * that every declared media file exists.
 */
function resolveBackgroundMedia(skins) {
  for (const { name, dir, meta } of skins) {
    const media = meta.contributes && meta.contributes.backgroundMedia
    if (!media) continue
    for (const mode of ['light', 'dark']) {
      const variant = media[mode]
      if (!variant) continue
      if (variant.type !== 'image' && variant.type !== 'video') {
        throw new Error(`skin ${name}: backgroundMedia.${mode}.type must be "image" or "video"`)
      }
      if (typeof variant.src !== 'string' || !variant.src || variant.src.includes('..') || path.isAbsolute(variant.src)) {
        throw new Error(`skin ${name}: backgroundMedia.${mode}.src must be a skin-relative path: ${variant.src}`)
      }
      const abs = path.resolve(dir, variant.src)
      if (!fs.existsSync(abs)) {
        throw new Error(`skin ${name}: backgroundMedia.${mode} does not exist: ${variant.src} (resolved inside ${path.relative(ROOT, dir)})`)
      }
      variant.src = path.posix.join('packages', 'skins', 'skin-center', 'skins', name, ...variant.src.split('/'))
    }
  }
}

function resolvePreviews(skins) {
  for (const { name, dir, meta } of skins) {
    const preview = meta.preview
    if (!preview || typeof preview !== 'object') {
      throw new Error(`skin ${name}: missing skin.json "preview" object`)
    }
    for (const mode of ['light', 'dark']) {
      const rel = preview[mode]
      if (typeof rel !== 'string' || !rel) {
        throw new Error(`skin ${name}: missing skin.json preview.${mode}`)
      }
      if (!fs.existsSync(path.resolve(dir, rel))) {
        throw new Error(`skin ${name}: preview.${mode} does not exist: ${rel} (resolved inside ${path.relative(ROOT, dir)})`)
      }
      preview[mode] = path.posix.join('packages', 'skins', 'skin-center', 'skins', name, ...rel.split('/'))
    }
  }
}

function renderManifestJs(skins) {
  const entries = skins.map(({ meta }) => meta)
  const stamp = new Date().toISOString().slice(0, 10)
  return [
    '/* Generated by scripts/gallery-build — do not edit by hand. */',
    `window.SKIN_MANIFEST = ${JSON.stringify({ generated: stamp, skins: entries }, null, 2)};`,
    '',
  ].join('\n')
}

/**
 * Compare a candidate manifest against the committed one, ignoring the
 * embedded daily `generated` timestamp so --check is deterministic across
 * days that do not rebuild (rebuilding changes nothing else).
 */
function manifestMatches(committed, candidate) {
  if (committed === candidate) return true
  const stripGenerated = (text) => JSON.parse(
    text
      .replace(/^\/\*[\s\S]*?\*\/\s*/, '')
      .replace(/^window\.SKIN_MANIFEST = /, '')
      .replace(/;\s*$/, '')
  )
  try {
    const a = stripGenerated(committed)
    const b = stripGenerated(candidate)
    delete a.generated
    delete b.generated
    return JSON.stringify(a) === JSON.stringify(b)
  } catch {
    return false
  }
}

function renderStylesJs(skins) {
  const lines = [
    '/* Generated by scripts/gallery-build — do not edit by hand. */',
    '/* Each value is the raw text of the v2 skin\'s contributed stylesheets',
    '   (skin.css + optional patches.css). The preview simulator injects them',
    '   into the official-facade snapshot; skin JS (hooks.mjs) is never executed. */',
    'window.SKIN_STYLES = {',
  ]
  for (const { name, dir, meta } of skins) {
    const contributes = meta.contributes || {}
    const stylesheet = readSkinFile(dir, contributes.stylesheet, 'contributes.stylesheet')
    if (stylesheet === null) {
      throw new Error(`skin ${name}: missing skin.json contributes.stylesheet`)
    }
    const patches = readSkinFile(dir, contributes.patches, 'contributes.patches')
    lines.push(`\t${JSON.stringify(meta.id)}: {`)
    lines.push(`\t\tstylesheet: ${JSON.stringify(stylesheet)},`)
    lines.push(`\t\tpatches: ${patches === null ? 'null' : JSON.stringify(patches)},`)
    lines.push('\t},')
  }
  lines.push('};', '')
  return lines.join('\n')
}

function writeIfChanged(file, content) {
  const exists = fs.existsSync(file)
  if (exists && fs.readFileSync(file, 'utf8') === content) return false
  fs.mkdirSync(path.dirname(file), { recursive: true })
  fs.writeFileSync(file, content)
  return true
}

const check = process.argv.includes('--check')
const skins = scanSkins()
resolvePreviews(skins)
resolveBackgroundMedia(skins)

const manifest = renderManifestJs(skins)
const styles = renderStylesJs(skins)

if (check) {
  const stale = []
  const manifestPath = path.join(GALLERY_DIR, 'manifest.js')
  if (fs.existsSync(manifestPath) &&
      !manifestMatches(fs.readFileSync(manifestPath, 'utf8'), manifest)) stale.push('manifest.js')
  if (fs.existsSync(path.join(GALLERY_DIR, 'styles.js')) &&
      fs.readFileSync(path.join(GALLERY_DIR, 'styles.js'), 'utf8') !== styles) stale.push('styles.js')
  if (stale.length) {
    console.error(`gallery assets stale (run scripts/gallery-build): ${stale.join(', ')}`)
    process.exit(1)
  }
  console.log(`gallery assets up to date (${skins.length} skins)`)
  process.exit(0)
}

const changed = []
if (writeIfChanged(path.join(GALLERY_DIR, 'manifest.js'), manifest)) changed.push('manifest.js')
if (writeIfChanged(path.join(GALLERY_DIR, 'styles.js'), styles)) changed.push('styles.js')
console.log(`gallery-build: ${skins.length} skins → ${changed.length ? changed.join(', ') : 'nothing changed'}`)
