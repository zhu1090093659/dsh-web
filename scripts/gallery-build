#!/usr/bin/env node
'use strict'

/**
 * gallery-build — regenerate the gallery static assets for the dsh skin
 * collection (dsh-web-ui).
 *
 * Scans each packages/skins/<name>/skin.json (the per-skin metadata contract) and emits:
 *
 *   gallery/manifest.js  — window.SKIN_MANIFEST = [...skin metadata...]
 *   gallery/bundles.js   — window.SKIN_BUNDLES = { "<skinId>": "<bundle js>" }
 *
 * Everything is emitted as <script>-loadable JS (not fetched JSON) so the
 * gallery works from file:// — no server, no CORS — and can be pushed to
 * GitHub Pages unchanged. Bundle text is JSON.stringify-escaped into a
 * string literal, so any script content is safe.
 *
 * Usage: node scripts/gallery-build [--check]
 *   --check  verify the committed gallery assets are up to date (exit 1 if
 *            a rebuild would change them; used by CI / pre-commit).
 */

const fs = require('node:fs')
const path = require('node:path')

const ROOT = path.resolve(__dirname, '..')
const SKINS_DIR = path.join(ROOT, 'packages', 'skins')
const GALLERY_DIR = path.join(ROOT, 'gallery')

/** Required keys per skin metadata entry. */
const REQUIRED = ['id', 'name', 'author', 'tagline', 'accent', 'bodyAttr', 'package']

function readSkinMeta(dir) {
  const file = path.join(dir, 'skin.json')
  if (!fs.existsSync(file)) return null
  let meta
  try {
    meta = JSON.parse(fs.readFileSync(file, 'utf8'))
  } catch (err) {
    throw new Error(`skin.json parse error in ${dir}: ${err.message}`)
  }
  for (const key of REQUIRED) {
    if (!meta[key]) throw new Error(`skin ${dir}: missing required skin.json field "${key}"`)
  }
  return meta
}

function scanSkins() {
  const skins = []
  for (const name of fs.readdirSync(SKINS_DIR).sort()) {
    const dir = path.join(SKINS_DIR, name)
    if (!fs.statSync(dir).isDirectory()) continue
    const meta = readSkinMeta(dir)
    if (!meta) continue
    const bundle = path.join(dir, 'lib', 'client.js')
    if (!fs.existsSync(bundle)) throw new Error(`skin ${name}: lib/client.js missing (run pnpm bundle first)`)
    skins.push({ meta, bundle })
  }
  if (!skins.length) throw new Error('no skins found under packages/skins/')
  // 入库顺序（skin.json 的 order 字段）决定 Gallery 卡片顺序
  skins.sort((a, b) => (a.meta.order ?? 999) - (b.meta.order ?? 999))
  return skins
}

function validatePreviews(skins) {
  // Every skin.json preview.light/dark path must resolve (from repo root,
  // exactly how gallery/index.html loads them: '../' + preview.light) to an
  // existing file under packages/skins/<id>/preview/. Throw with the missing
  // files so both --check (exit 1) and normal mode fail loudly instead of
  // emitting a gallery whose screenshots are broken.
  const missing = []
  for (const { meta } of skins) {
    const preview = meta.preview
    if (!preview || typeof preview !== 'object') {
      throw new Error(`skin ${meta.id}: missing skin.json "preview" object`)
    }
    for (const mode of ['light', 'dark']) {
      const rel = preview[mode]
      if (typeof rel !== 'string' || !rel) {
        throw new Error(`skin ${meta.id}: missing skin.json preview.${mode}`)
      }
      if (!fs.existsSync(path.resolve(ROOT, rel))) {
        missing.push(`  ${meta.id} (preview.${mode}): ${rel}`)
      }
    }
  }
  if (missing.length) {
    throw new Error(
      'preview image(s) referenced by skin.json do not exist (resolved from repo root):\n' +
      missing.join('\n')
    )
  }
}

function renderManifestJs(skins) {
  const entries = skins.map(({ meta }) => meta)
  const stamp = new Date().toISOString().slice(0, 10)
  return [
    '/* Generated by scripts/gallery-build — do not edit by hand. */',
    `window.SKIN_MANIFEST = ${JSON.stringify({ generated: stamp, skins: entries }, null, 2)};`,
    '',
  ].join('\n')
}

/**
 * Compare a candidate manifest against the committed one, ignoring the
 * embedded daily `generated` timestamp so --check is deterministic across
 * days that do not rebuild (rebuilding changes nothing else).
 */
function manifestMatches(committed, candidate) {
  if (committed === candidate) return true
  const stripGenerated = (text) => JSON.parse(
    text
      .replace(/^\/\*[\s\S]*?\*\/\s*/, '')
      .replace(/^window\.SKIN_MANIFEST = /, '')
      .replace(/;\s*$/, '')
  )
  try {
    const a = stripGenerated(committed)
    const b = stripGenerated(candidate)
    delete a.generated
    delete b.generated
    return JSON.stringify(a) === JSON.stringify(b)
  } catch {
    return false
  }
}

function renderBundlesJs(skins) {
  const lines = [
    '/* Generated by scripts/gallery-build — do not edit by hand. */',
    '/* Each value is the full text of packages/skins/<id>/lib/client.js (CSS + chrome',
    '   factory inlined). The preview simulator evaluates it inside its own',
    '   iframe with a __ModuleLoader__ shim and captures exports.apply. */',
    'window.SKIN_BUNDLES = {',
  ]
  for (const { meta, bundle } of skins) {
    const text = fs.readFileSync(bundle, 'utf8')
    lines.push(`\t${JSON.stringify(meta.id)}: ${JSON.stringify(text)},`)
  }
  lines.push('};', '')
  return lines.join('\n')
}

function writeIfChanged(file, content) {
  const exists = fs.existsSync(file)
  if (exists && fs.readFileSync(file, 'utf8') === content) return false
  fs.mkdirSync(path.dirname(file), { recursive: true })
  fs.writeFileSync(file, content)
  return true
}

const check = process.argv.includes('--check')
const skins = scanSkins()
validatePreviews(skins)

const manifest = renderManifestJs(skins)
const bundles = renderBundlesJs(skins)

if (check) {
  const stale = []
  const manifestPath = path.join(GALLERY_DIR, 'manifest.js')
  if (fs.existsSync(manifestPath) &&
      !manifestMatches(fs.readFileSync(manifestPath, 'utf8'), manifest)) stale.push('manifest.js')
  if (fs.existsSync(path.join(GALLERY_DIR, 'bundles.js')) &&
      fs.readFileSync(path.join(GALLERY_DIR, 'bundles.js'), 'utf8') !== bundles) stale.push('bundles.js')
  if (stale.length) {
    console.error(`gallery assets stale (run scripts/gallery-build): ${stale.join(', ')}`)
    process.exit(1)
  }
  console.log(`gallery assets up to date (${skins.length} skins)`)
  process.exit(0)
}

const changed = []
if (writeIfChanged(path.join(GALLERY_DIR, 'manifest.js'), manifest)) changed.push('manifest.js')
if (writeIfChanged(path.join(GALLERY_DIR, 'bundles.js'), bundles)) changed.push('bundles.js')
console.log(`gallery-build: ${skins.length} skins → ${changed.length ? changed.join(', ') : 'nothing changed'}`)
