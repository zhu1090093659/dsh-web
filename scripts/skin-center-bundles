#!/usr/bin/env node
/**
 * Regenerate the skin-center's skin registry:
 *   packages/skins/skin-center/src/client/generated/skins.ts
 * (metadata from every packages/skins/<name>/skin.json). The client bundle
 * TEXT is deliberately NOT embedded here: the GUI must not parse ~700KB of
 * base64 art on every startup, so try-on fetches each skin's prebuilt
 * lib/client.js on demand from the host route
 * /api/skin-center/bundle/<id> (see src/routes.ts) and executes it as a real
 * same-origin script — no eval. The skin's lib/client.js is still validated
 * here so a missing build fails loudly at generation time, not at try-on.
 *
 * Re-run whenever a skin's metadata changes, then rebuild the skin-center
 * bundle in the checkout:
 *   node scripts/skin-center-bundles
 *   (build: see packages/skins/skin-center/README.md)
 */
'use strict'

const fs = require('node:fs')
const path = require('node:path')

const ROOT = path.resolve(__dirname, '..')
const SKINS_DIR = path.join(ROOT, 'packages', 'skins')
const OUT_DIR = path.join(ROOT, 'packages', 'skins', 'skin-center', 'src', 'client', 'generated')
const OUT_FILE = path.join(OUT_DIR, 'skins.ts')

/** skin.json files under packages/skins/, ordered by their `order` field. */
function collectSkins() {
  const entries = []
  for (const dir of fs.readdirSync(SKINS_DIR)) {
    const skinJson = path.join(SKINS_DIR, dir, 'skin.json')
    if (!fs.statSync(skinJson, { throwIfNoEntry: false })) continue
    const meta = JSON.parse(fs.readFileSync(skinJson, 'utf8'))
    if (typeof meta.id !== 'string' || typeof meta.package !== 'string') {
      throw new Error(`packages/skins/${dir}/skin.json: missing id/package`)
    }
    const bundle = path.join(SKINS_DIR, dir, 'lib', 'client.js')
    if (!fs.statSync(bundle, { throwIfNoEntry: false })) {
      throw new Error(`packages/skins/${dir}: missing lib/client.js (build the skin bundle first)`)
    }
    entries.push({ dir, meta })
  }
  entries.sort((a, b) => (a.meta.order ?? 99) - (b.meta.order ?? 99))
  return entries
}

function pick(meta, keys) {
  const out = {}
  for (const key of keys) {
    if (meta[key] !== undefined) out[key] = meta[key]
  }
  return out
}

function main() {
  const skins = collectSkins()
  if (skins.length === 0) throw new Error('no skins found under packages/skins/')
  fs.mkdirSync(OUT_DIR, { recursive: true })

  const rows = skins.map(({ meta }) => {
    const record = pick(meta, [
      'id', 'name', 'nameEn', 'author', 'tagline', 'description', 'tags',
      'accent', 'bodyAttr', 'package', 'order',
    ])
    return `  ${JSON.stringify(record)},\n`
  })

  const out = [
    '/**',
    ' * AUTO-GENERATED by scripts/skin-center-bundles — do not edit by hand.',
    ' * Skin registry for the GUI skin center: gallery metadata only. Client',
    " * bundle text is NOT embedded here — try-on fetches each skin's",
    " * prebuilt lib/client.js on demand from the host route",
    " * /api/skin-center/bundle/<id> (a same-origin script executed by the",
    " * page's own module loader; no eval, and the GUI never parses the",
    ' * embedded art base64 at startup).',
    ' * Regenerate with `node scripts/skin-center-bundles`.',
    ' */',
    '',
    '/** One registry entry: gallery metadata for the skin center card. */',
    'export interface SkinCenterEntry {',
    '  /** Skin id (packages/skins/<id>/). */',
    '  id: string',
    '  /** Display name (zh). */',
    '  name: string',
    '  /** Display name (en). */',
    '  nameEn: string',
    '  /** One-line tagline. */',
    '  tagline: string',
    '  /** Accent color for the swatch. */',
    '  accent: string',
    '  /** Author credit. */',
    '  author?: string',
    '  /** Longer description. */',
    '  description?: string',
    '  /** Tag list. */',
    '  tags?: string[]',
    '  /** Body attribute that scopes the skin styles. */',
    '  bodyAttr: string',
    '  /** Plugin package name (the boot-graph entry id when active). */',
    '  package: string',
    '  /** Gallery sort order (packages/skins/<name>/skin.json). */',
    '  order?: number',
    '}',
    '',
    '/** Every skin, ordered by packages/skins/<name>/skin.json `order`. */',
    `export const SKIN_CENTER_ENTRIES: readonly SkinCenterEntry[] = [`,
    ...rows,
    ']',
    '',
  ].join('\n')

  const bytes = Buffer.byteLength(out)
  const CHECK = process.argv.includes('--check')
  if (CHECK) {
    const current = fs.readFileSync(OUT_FILE, 'utf8').replace(/\r\n/g, '\n')
    if (current === out) {
      console.log(`skin-center-bundles: check OK (${skins.length} skins, generated file in sync)`)
      return
    }
    console.error(`skin-center-bundles: check FAILED — ${path.relative(ROOT, OUT_FILE)} differs from generated content`)
    console.error('  run `node scripts/skin-center-bundles` to regenerate, then rebuild the skin-center bundle')
    process.exit(1)
  }
  fs.writeFileSync(OUT_FILE, out)
  console.log(`skin-center-bundles: wrote ${path.relative(ROOT, OUT_FILE)} (${skins.length} skins, ${(bytes / 1024).toFixed(0)} KiB)`)
}

main()
